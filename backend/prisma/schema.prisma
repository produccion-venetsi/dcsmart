generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model App {
  id         String   @id @default(uuid())
  nombre     String
  slug       String   @unique
  activo     Boolean  @default(true)
  solo_super_admin Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  locales        Local[]
  user_app_roles UserAppRole[]
  detalle_tipos  DetalleTipo[]
  local_access   UserLocalAccess[]
  usage          UserAppUsage[]
  clientes       Cliente[]

  @@map("apps")
}

model Local {
  id            String     @id @default(uuid())
  nombre        String
  direccion     String?
  telefono      String?
  activo        Boolean    @default(true)
  id_app        String
  id_proveedor  String?
  logo_url      String?
  maps_url      String?
  menu_url      String?
  mail_facturas String?
  tipo_local    TipoLocal?
  // Descuento automatico que se aplica al cargar un MovStock, en porcentaje
  // sobre el neto. Es 30% para todos salvo que el local tenga otro pactado, por
  // eso el default vive en la base: los locales que ya existen quedan en 30 sin
  // tener que actualizar nada. NULL nunca deberia darse gracias al default,
  // pero si aparece el codigo lo trata como el 30 general.
  descuento_movstock Decimal? @default(30) @db.Decimal(5, 2)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  app           App               @relation(fields: [id_app], references: [id])
  proveedor     Proveedor?        @relation(fields: [id_proveedor], references: [id])
  cajas         Caja[]
  pagos         Pago[]
  pdps          Pdp[]
  arqueos       Arqueo[]
  local_access  UserLocalAccess[]
  detalle_tipos DetalleTipo[]
  movimientos_cm MovimientoCM[]

  @@map("locales")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  nombre        String
  password_hash String?
  google_id     String?  @unique
  avatar_url    String?
  activo        Boolean  @default(true)
  // Ultimo ingreso exitoso. Pasados DIAS_INACTIVIDAD dias (ver lib/inactividad)
  // la contrasena deja de servir y hay que pedir que la reseteen.
  //
  // Arranca en NULL para todos los usuarios que ya existen y NULL NO bloquea:
  // significa "todavia no lo sabemos" y el primer login lo completa. Resetear
  // la contrasena tambien lo vuelve a NULL, que es como se destraba una cuenta.
  last_login    DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user_app_roles   UserAppRole[]
  user_permissions UserPermission[]
  cajas_creadas    Caja[]            @relation("CajaCreatedBy")
  pagos_creados    Pago[]            @relation("PagoCreatedBy")
  pdps_creados     Pdp[]             @relation("PdpCreatedBy")
  arqueos_creados  Arqueo[]          @relation("ArqueoCreatedBy")
  local_access     UserLocalAccess[]
  audits           Audit[]           @relation("AuditUser")
  app_usage        UserAppUsage[]
  activity_logs    ActivityLog[]     @relation("ActivityLogUser")
  filtro_presets   FiltroPreset[]    @relation("FiltroPresetUser")
  notificaciones   Notificacion[]    @relation("NotificacionUser")
  mov_cm_creados   MovimientoCM[]    @relation("MovimientoCMCreatedBy")
  mov_cm_recibidos MovimientoCM[]    @relation("MovimientoCMRecibidaBy")

  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?

  user_app_roles   UserAppRole[]
  role_permissions RolePermission[]

  @@map("roles")
}

model Module {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  role_permissions RolePermission[]
  user_permissions UserPermission[]

  @@map("modules")
}

model UserLocalAccess {
  id       String @id @default(uuid())
  id_user  String
  id_app   String
  id_local String

  user  User  @relation(fields: [id_user], references: [id])
  app   App   @relation(fields: [id_app], references: [id])
  local Local @relation(fields: [id_local], references: [id])

  @@unique([id_user, id_app, id_local])
  @@map("user_local_access")
}

model RolePermission {
  id         String  @id @default(uuid())
  id_role    String
  id_module  String
  can_view   Boolean @default(false)
  can_create Boolean @default(false)
  can_edit   Boolean @default(false)
  can_delete Boolean @default(false)

  role   Role   @relation(fields: [id_role], references: [id])
  module Module @relation(fields: [id_module], references: [id])

  @@unique([id_role, id_module])
  @@map("role_permissions")
}

model UserAppRole {
  id      String  @id @default(uuid())
  id_user String
  id_app  String? // null = acceso global (super_admin / dcsmart)
  id_role String

  user User @relation(fields: [id_user], references: [id])
  app  App? @relation(fields: [id_app], references: [id])
  role Role @relation(fields: [id_role], references: [id])

  @@unique([id_user, id_app])
  @@map("user_app_roles")
}

model UserAppUsage {
  id_user      String
  id_app       String
  last_used_at DateTime @default(now())

  user User @relation(fields: [id_user], references: [id])
  app  App  @relation(fields: [id_app], references: [id])

  @@id([id_user, id_app])
  @@map("user_app_usage")
}

model UserPermission {
  id         String  @id @default(uuid())
  id_user    String
  id_module  String
  can_view   Boolean @default(false)
  can_create Boolean @default(false)
  can_edit   Boolean @default(false)
  can_delete Boolean @default(false)

  user   User   @relation(fields: [id_user], references: [id])
  module Module @relation(fields: [id_module], references: [id])

  @@unique([id_user, id_module])
  @@map("user_permissions")
}

model Rubro {
  id     String @id @default(uuid())
  nombre String @unique

  rubcats RubCat[]

  @@map("rubros")
}

model Categoria {
  id     String @id @default(uuid())
  nombre String @unique

  rubcats RubCat[]

  @@map("categorias")
}

model RubCat {
  id            String  @id @default(uuid())
  id_cat        String
  id_rub        String
  cuenta        String?
  tipo          String?
  costo         String?
  clasificacion String?

  categoria   Categoria   @relation(fields: [id_cat], references: [id])
  rubro       Rubro       @relation(fields: [id_rub], references: [id])
  pagos       Pago[]
  proveedores Proveedor[]

  @@unique([id_cat, id_rub])
  @@map("rubcat")
}

// A nombre de quién se generó un gasto. Es lo contrario de `Proveedor` -- a quién se
// le paga -- y no se mezclan: un mismo Pago puede tener los dos, el proveedor al que
// se le pagó y el cliente que lo debe.
//
// A diferencia de Proveedor, que es un catálogo global, un Cliente pertenece a un
// grupo: mismo patrón que DetalleTipo (ver routes/detalle_tipos.js). Un cliente de un
// grupo no tiene por qué existir en otro, y si el mismo cliente real le compra a dos
// grupos se carga en los dos -- son cuentas corrientes separadas.
model Cliente {
  id            String   @id @default(uuid())
  id_app        String
  nombre        String?
  razon_social  String?
  cuit          String?
  telefono      String?
  mail          String?
  observaciones String?
  activo        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  app   App    @relation(fields: [id_app], references: [id])
  pagos Pago[]

  @@index([id_app])
  @@map("clientes")
}

model Proveedor {
  id            String   @id @default(uuid())
  nombre        String?
  razon_social  String?
  cuit          String?
  banco         String?
  cbu           String?
  alias         String?
  direccion_url String?
  detalle_direc String?
  telefono      String?
  mail_contacto String?
  mail_envio    String?
  tag           String?
  cuenta        String?
  observaciones String?
  tipo_local    String?
  tipo          String?
  id_rubcat     String?
  plazo         Int?
  activo        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Afinidad con el tipo de local, para ordenar el buscador de proveedores:
  // los afines y los generales primero. Nunca filtra, solo ordena -- un local
  // siempre puede elegir cualquier proveedor.
  //
  // `tipos_afines` es distinto del viejo `tipo_local` (texto libre, hoy con
  // 4014 registros en "GASTRONOMICO" cargados en una migracion). Se dejan los
  // dos: el viejo sigue siendo el dato historico y este es el que ordena.
  // Vacio = sin clasificar, va al final.
  // El default en la base es obligatorio, no cosmético: sin él las filas nuevas
  // quedan en NULL y en Postgres `NOT (NULL OR false)` da NULL, así que el
  // proveedor desaparece de las DOS mitades del buscador (ver lib/afinidadProveedor.js,
  // que documenta el bug que eso causó). Se declara acá para que `migrate diff` no
  // proponga quitarlo: Prisma no lo infiere de `TipoLocal[]`.
  tipos_afines  TipoLocal[] @default([])
  es_general    Boolean  @default(false) // servicios transversales: Aysa, Metrogas, AFIP, bancos

  rubcat  RubCat? @relation(fields: [id_rubcat], references: [id])
  pagos   Pago[]
  locales Local[]

  // Ver el comentario en Impuesto: las FK necesitan su índice a mano.
  @@index([id_rubcat])
  @@map("proveedores")
}

model MetodoPago {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  caja_movimientos CajaMovimiento[]
  pagos            Pago[]

  @@map("metodos_pago")
}

model Caja {
  id            String    @id @default(uuid())
  nro_turno     String?
  tipo_turno    TipoTurno?
  fecha_inicio  DateTime
  fecha_cierre  DateTime?
  id_local      String
  cajero        String?
  total         Decimal?  @db.Decimal(12, 2)
  efectivo      Decimal?  @db.Decimal(12, 2)
  fiscal        Decimal?  @db.Decimal(12, 2)
  comensales    Int?
  tickets       Int?
  observaciones String?
  foto_url      String?
  id_externo    String?
  origin        Origin    @default(DCSMART)
  created_by    String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  local       Local            @relation(fields: [id_local], references: [id])
  creador     User?            @relation("CajaCreatedBy", fields: [created_by], references: [id])
  movimientos CajaMovimiento[]
  detalles    CajaDetalle[]

  @@index([id_local, fecha_inicio])
  @@index([id_local, id_externo])
  @@map("cajas")
}

model DetalleTipo {
  id            String  @id @default(uuid())
  id_app        String
  id_local      String?
  nombre        String
  clasificacion String  @default("otro")
  activo        Boolean @default(true)

  app             App             @relation(fields: [id_app], references: [id])
  local           Local?          @relation(fields: [id_local], references: [id])
  detalles        CajaDetalle[]
  arqueo_detalles ArqueoDetalle[]

  @@unique([nombre, id_app])
  @@map("detalle_tipos")
}

model Arqueo {
  id           String   @id @default(uuid())
  id_local     String
  fecha        DateTime
  caja_fuerte  Decimal  @db.Decimal(12, 2)
  cofre        Decimal  @db.Decimal(12, 2)
  adicion      Decimal  @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  ingresos     Decimal  @db.Decimal(12, 2)
  gastos       Decimal  @db.Decimal(12, 2)
  comprobacion Decimal  @db.Decimal(12, 2)
  observaciones String?
  created_by   String?
  created_at   DateTime @default(now())

  local    Local           @relation(fields: [id_local], references: [id])
  creador  User?           @relation("ArqueoCreatedBy", fields: [created_by], references: [id])
  detalles ArqueoDetalle[]

  @@index([id_local, fecha])
  @@map("arqueos")
}

model ArqueoDetalle {
  id         String   @id @default(uuid())
  id_arqueo  String
  id_tipo    String?
  nombre     String?
  monto      Decimal  @db.Decimal(12, 2)
  created_at DateTime @default(now())

  arqueo       Arqueo       @relation(fields: [id_arqueo], references: [id])
  detalle_tipo DetalleTipo? @relation(fields: [id_tipo], references: [id])

  @@map("arqueo_detalles")
}

model CajaDetalle {
  id            String   @id @default(uuid())
  id_caja       String
  tipo          String?
  id_tipo       String?
  nombre        String?
  monto         Decimal  @db.Decimal(12, 2)
  observaciones String?
  created_at    DateTime @default(now())

  caja         Caja         @relation(fields: [id_caja], references: [id])
  detalle_tipo DetalleTipo? @relation(fields: [id_tipo], references: [id])

  // Postgres NO indexa las FK solo, y Prisma tampoco: sin estos índices toda
  // consulta por id_caja escaneaba la tabla entera. El listado de cajas trae
  // los detalles de cada caja de la página para calcular el cuadre y el total,
  // asi que eran dos escaneos completos por pantalla. Medido: 3,2 ms -> 0,46 ms.
  @@index([id_caja])
  @@index([id_tipo])
  @@map("caja_detalles")
}

enum Origin {
  DCSMART
  TAPTAP
  FFUDO

  @@map("origin")
}

enum TipoTurno {
  MANANA    @map("Mañana")
  TARDE     @map("Tarde")
  NOCHE     @map("Noche")
  TRASNOCHE @map("Trasnoche")
  EVENTO    @map("Evento")
  OTROS     @map("Otros")

  @@map("tipo_turno")
}

// Rubro del local. Los valores se guardan con acento porque dcsmart-analisis
// lee esta misma base sin un contrato compartido: conviene que el dato sea
// legible por si solo, igual que TipoTurno.
enum TipoLocal {
  GASTRONOMIA  @map("Gastronomía")
  INDUMENTARIA @map("Indumentaria")
  ARQUITECTURA @map("Arquitectura")
  INMOBILIARIO @map("Inmobiliario")
  MULTIMEDIA   @map("Multimedia")

  @@map("tipo_local")
}

enum TipoMovimiento {
  INICIAL
  INGRESO
  GASTO
  COBRO
  RETIRO
  VACIADO
  EGRESO

  @@map("tipo_movimiento")
}

model CajaMovimiento {
  id        String         @id @default(uuid())
  tipo      TipoMovimiento
  id_metodo String?
  monto     Decimal        @db.Decimal(12, 2)
  id_caja   String
  cantidad  Int?

  caja        Caja        @relation(fields: [id_caja], references: [id])
  metodo_pago MetodoPago? @relation(fields: [id_metodo], references: [id])

  // Ver el comentario en CajaDetalle: mismo motivo. Medido: 2,1 ms -> 0,44 ms.
  @@index([id_caja])
  @@map("caja_movimientos")
}

model Pago {
  id             String    @id @default(uuid())
  nro_ord        Int?
  fecha          DateTime?
  id_proveedor   String?
  id_rubcat      String?
  id_tipo        TipoPago?
  pv             Int?
  nro            BigInt?
  importe_neto   Decimal?  @db.Decimal(12, 2)
  descuento      Decimal?  @db.Decimal(12, 2)
  importe        Decimal?  @db.Decimal(12, 2)
  id_metodo      String?
  cashflow       DateTime?
  observaciones  String?
  pagado         Boolean   @default(false)
  fecha_pago     DateTime?
  estado_op      EstadoOp?
  foto_url       String?
  pdf_url        String?
  periodo        DateTime?
  ingresa_egreso Boolean   @default(true)
  periodico      Boolean   @default(false)
  cargado_con_ia Boolean   @default(false)
  id_local       String?
  created_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  id_pdp     String?
  id_eventos String?
  id_cheque  String?

  // A nombre de quién se generó el gasto. Solo se carga cuando estado_op es
  // CTA_CTE_CLI: es la regla de negocio del módulo de clientes y la valida el
  // backend, no solo el formulario. Reemplaza a `id_ctacte`, que quedó reservada y
  // nunca se usó (cero referencias en código) -- y cuyo nombre además evocaba el
  // CUENTA_CTE de proveedores, que significa lo contrario.
  id_cliente String?

  proveedor   Proveedor?    @relation(fields: [id_proveedor], references: [id])
  rubcat      RubCat?       @relation(fields: [id_rubcat], references: [id])
  metodo_pago MetodoPago?   @relation(fields: [id_metodo], references: [id])
  local       Local?        @relation(fields: [id_local], references: [id])
  creador     User?         @relation("PagoCreatedBy", fields: [created_by], references: [id])
  pdp         Pdp?          @relation(fields: [id_pdp], references: [id])
  cliente     Cliente?      @relation(fields: [id_cliente], references: [id])
  impuestos   Impuesto[]
  multimoneda MultiMoneda[]
  // Solo existe si la op es de tipo CM y alguien la gestionó en Caja Mayor.
  movimiento_cm MovimientoCM?

  @@index([id_local, fecha])
  @@index([pagado])
  @@index([estado_op])
  // La cuenta corriente de un cliente pide sus pagos ordenados por fecha. Prisma no
  // indexa las FK solo y ya hubo cinco casos de lentitud por eso (ver PR #114).
  @@index([id_cliente, fecha])
  @@map("pagos")
}

enum TipoPago {
  A
  B
  C
  CM
  DC_1 @map("DC (1)")
  DC_2 @map("DC (2)")
  DDJJ
  FF
  LF
  M
  NCA
  NCB
  NDA
  ND
  STK
  X

  @@map("tipo_pago")
}

// CUENTA_CTE y CTA_CTE_CLI apuntan en direcciones opuestas y no hay que confundirlos:
//   CUENTA_CTE  -> la empresa todavía no le pagó a ESE PROVEEDOR (es la "Deuda" del
//                  dashboard de PDP)
//   CTA_CTE_CLI -> el gasto se generó a nombre de un CLIENTE, que se lo debe a la
//                  empresa
// Por eso es un estado nuevo y no se reusa el existente.
enum EstadoOp {
  CAJA
  CUENTA_CTE  @map("CUENTA CTE")
  MP_PDP      @map("MP PDP")
  PDP
  CTA_CTE_CLI @map("CTA CTE CLI")

  @@map("estado_op")
}

model Impuesto {
  id      String       @id @default(uuid())
  id_pago String
  tipo    TipoImpuesto
  monto   Decimal      @db.Decimal(12, 2)

  pago Pago @relation(fields: [id_pago], references: [id])

  // El más importante de todos: sin este índice, cada lectura de los impuestos
  // de un pago escaneaba las 30 mil filas de la tabla para devolver dos.
  // Medido: 3,4 ms -> 0,10 ms, y 352 páginas leídas -> 4.
  @@index([id_pago])
  @@map("impuestos")
}

model MultiMoneda {
  id      String   @id @default(uuid())
  id_pago String
  tipo    String
  tdc     Decimal  @db.Decimal(12, 4)
  monto   Decimal  @db.Decimal(12, 2)
  fecha   DateTime @default(now())

  pago Pago @relation(fields: [id_pago], references: [id])

  @@unique([id_pago])
  @@map("multimoneda")
}

enum TipoImpuesto {
  IVA21
  IVA27
  IVA10
  RETENCION
  PERCEPCION
  IMP_INTERNOS

  @@map("tipo_impuesto")
}

model Audit {
  id            String    @id @default(uuid()) @db.Uuid
  id_registro   String
  tabla         String
  tipo          String
  accion        String    @default("auditado")
  aprobado      Boolean?  @default(false)
  vigente       Boolean   @default(true)
  audit_dc      Boolean   @default(false)
  id_user       String?
  fecha         DateTime?
  observaciones String?
  created_at    DateTime? @default(now())
  updated_at    DateTime? @default(now())

  user User? @relation("AuditUser", fields: [id_user], references: [id])

  @@index([tabla, id_registro, vigente])
  @@index([tabla, id_registro, fecha])
  @@map("audits")
}

// Log de actividad CRUD (crear/editar/eliminar), solo visible para
// super_admin. Genérico por `tabla` para poder extenderse a otras entidades
// más adelante; hoy solo se escribe para `tabla = 'pagos'`. `snapshot` guarda
// el registro completo en formato JSON en el momento de la acción -- para
// "eliminado" es el último estado antes del hard delete (el borrado en sí no
// cambia, esto es solo el rastro de auditoría).
model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  tabla       String
  id_registro String
  id_local    String
  accion      String // 'creado' | 'editado' | 'eliminado'
  id_user     String?
  fecha       DateTime @default(now())
  snapshot    Json

  user User? @relation("ActivityLogUser", fields: [id_user], references: [id])

  @@index([tabla, id_local, fecha])
  @@index([id_registro])
  @@map("activity_log")
}

model Pdp {
  id              String    @id @default(uuid())
  id_local        String
  created_by      String?
  created_at      DateTime  @default(now())
  ultima_descarga DateTime?
  pdf_url         String
  cantidad_pagos  Int
  total           Decimal   @db.Decimal(12, 2)

  local   Local  @relation(fields: [id_local], references: [id])
  creador User?  @relation("PdpCreatedBy", fields: [created_by], references: [id])
  pagos   Pago[]

  @@index([id_local, created_at])
  @@map("pdp")
}

model TapTapSyncRun {
  id          String    @id @default(uuid())
  started_at  DateTime  @default(now())
  finished_at DateTime?
  resultado   Json?     // { "kjhggtrer": { turnosNuevos: 3, error: null }, ... } por id_local
  ok          Boolean   @default(true)

  @@map("taptap_sync_runs")
}

// Filtros guardados por usuario ("mis filtros") de las pantallas de listado.
// `modulo` existe para que la misma tabla sirva a pagos y despues a cajas sin
// migrar de nuevo. El tope de 5 por usuario y modulo se valida en la ruta, no
// en el esquema: Postgres no puede expresar "maximo N filas por grupo" sin un
// trigger, y un trigger seria mas dificil de encontrar que la validacion.
// Avisos dirigidos a un usuario. Hoy solo se emiten cuando alguien revierte una
// auditoria: el auditor tiene que enterarse de que le desauditaron algo sin
// depender de que revise la pantalla de Auditorias.
//
// `tabla` + `id_registro` es el mismo patron polimorfico que usa Audit, y por el
// mismo motivo: el aviso puede apuntar a un pago o a una caja, y no se le puede
// poner una FK a las dos. Sirven para armar el link, no para integridad.
model Notificacion {
  id          String   @id @default(uuid())
  id_user     String
  tipo        String
  titulo      String
  cuerpo      String?
  tabla       String?
  id_registro String?
  id_local    String?
  leida       Boolean  @default(false)
  // `hecha` es distinto de `leida`: leida se marca sola al abrir el aviso, asi que no
  // dice si la tarea se resolvio. Un aviso de desauditoria es alguien pidiendo que
  // revises algo, y eso se cierra cuando lo hiciste, no cuando lo miraste.
  hecha       Boolean  @default(false)
  hecha_at    DateTime?
  created_at  DateTime @default(now())

  user User @relation("NotificacionUser", fields: [id_user], references: [id])

  // id_user va primero en los tres indices: todas las consultas son "las mias".
  // El primero cubre ademas la FK, que Prisma no indexa sola -- ver el PR #114,
  // donde justamente cuatro FK sin indice escaneaban tablas enteras.
  @@index([id_user, leida])
  // El contador del sidebar pregunta "cuantas me faltan": sin este indice escanea
  // todas las notificaciones del usuario en cada refresco.
  @@index([id_user, hecha])
  @@index([id_user, created_at])
  @@map("notificaciones")
}

model FiltroPreset {
  id         String   @id @default(uuid())
  id_user    String
  modulo     String   // 'pagos' | 'cajas'
  nombre     String
  filtros    Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation("FiltroPresetUser", fields: [id_user], references: [id], onDelete: Cascade)

  @@unique([id_user, modulo, nombre])
  @@index([id_user, modulo])
  @@map("filtro_presets")
}

// ─── CAJA MAYOR ──────────────────────────────────────────────────────────────
// Reemplazo del AppSheet DC-CAJA MAYOR (app CM-PERROS-334067). Solo super_admin,
// sobre TODOS los locales de todos los grupos a la vez -- ver routes/caja_mayor.js.
//
// Cuando se carga un Pago con id_tipo = 'CM', se COPIA acá como un movimiento con
// estado ENVIADA: el local mandó la plata al CM y el CM después confirma que la
// recibió. La copia es el registro del envío, y queda relacionada con la op por
// `id_pago` -- que es único, así una op no puede entrar dos veces.
//
// Se copia en vez de leerse al vuelo porque el seguimiento es de lo que se envió:
// si después alguien corrige el pago en gestión, la copia se sincroniza (ver
// sincronizarMovimientoCM en lib/cajaMayor.js) para que el saldo no mienta, pero
// el movimiento existe desde el momento de la carga y no depende de que alguien
// lo toque en el módulo.

// Ciclo de una op que sale de gestión hacia la caja mayor: el local la ENVIA y el
// CM confirma que la RECIBIÓ. La app vieja llamaba ENVIADA "ESTUDIO" (1271 filas
// ahí contra 364 recibidas) -- mismo estado, nombre que no decía nada.
//
// Los movimientos que nacen en el módulo (PROPIO, APERTURA) no tienen este ciclo:
// nadie los envía. Quedan en ENVIADA y el módulo no les ofrece el botón.
enum EstadoCM {
  ENVIADA
  RECIBIDA

  @@map("estado_cm")
}

enum MonedaCM {
  ARS
  USD
  EUR
  BRL

  @@map("moneda_cm")
}

// De dónde salió el movimiento. Es lo que decide qué se puede editar: los PAGO
// son espejo de una op de gestión (acá solo se gestiona su estado), el resto
// nace y se edita en este módulo.
//
// En la app vieja esto era la columna `Movimiento`, un Yes/No: true para lo que
// llegaba de gestión (1622 filas con Orden OP-) y false para lo cargado a mano
// (1603 con Orden CM-). Acá es un enum porque además hay que distinguir el saldo
// de apertura, que allá se cargaba como un movimiento normal con la observación
// "Saldo Inicial" a mano (6 filas así en el export).
enum OrigenCM {
  PAGO     // op de gestión con id_tipo = 'CM'
  PROPIO   // cargado a mano en el módulo
  APERTURA // saldo inicial del local, uno por local y moneda

  @@map("origen_cm")
}

model MovimientoCM {
  id       String   @id @default(uuid())
  id_local String
  origen   OrigenCM
  moneda   MonedaCM @default(ARS)

  // Solo para origen PAGO: la op de gestión de la que es copia. Único, así una op
  // no puede entrar dos veces a la caja mayor -- es lo que hace que la copia sea
  // idempotente y no haya que cruzar por fecha+importe.
  id_pago String? @unique

  // Copiados del pago cuando origen = PAGO; propios en los demás casos. Nullable
  // solo porque la columna existía antes de que la copia fuera explícita: en la
  // práctica los movimientos siempre los tienen.
  fecha   DateTime?
  importe Decimal?  @db.Decimal(12, 2) // siempre positivo, la dirección va en `ingreso`

  // Dirección respecto de la CAJA MAYOR (no del local): true = entra plata a la
  // caja mayor. Al copiar se calcula con direccionCajaMayor() en lib/cajaMayor.js;
  // si alguien la corrige a mano queda `direccion_manual` en true y desde entonces
  // la sincronización no la vuelve a tocar.
  ingreso          Boolean?
  direccion_manual Boolean @default(false)

  estado           EstadoCM  @default(ENVIADA)
  recibe           String?
  extrae           String?
  fecha_extraccion DateTime?
  observaciones    String?

  // Quién y cuándo la marcó RECIBIDA. Es el dato que hoy no queda en ningún lado
  // cuando alguien aprieta el botón en AppSheet.
  recibida_at DateTime?
  recibida_by String?

  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  local    Local @relation(fields: [id_local], references: [id])
  pago     Pago? @relation(fields: [id_pago], references: [id])
  creador  User? @relation("MovimientoCMCreatedBy", fields: [created_by], references: [id])
  receptor User? @relation("MovimientoCMRecibidaBy", fields: [recibida_by], references: [id])

  // El listado siempre pide por local + moneda y ordena por fecha; el saldo
  // filtra por estado. Las FK van indexadas a propósito: Prisma no las indexa
  // sola y ya hubo cinco casos de lentitud por eso (ver PR #114).
  @@index([id_local, moneda, fecha])
  @@index([estado])
  @@index([created_by])
  @@index([recibida_by])
  @@map("movimientos_cm")
}

// Nota: NO hay tabla de cambio de moneda. La app vieja tenía una (`CAMBIO`, con
// importe, cotización y monedas de compra/venta) y quedó con CERO filas en dos
// años de uso, así que no se replicó. La caja en dólares sí existe y está viva
// -- 217 filas en CM_DOLAR -- pero se resuelve con la columna `moneda` de arriba,
// no con una tabla espejo como hacía AppSheet.
