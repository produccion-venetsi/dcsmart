generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model App {
  id               String   @id @default(uuid())
  nombre           String
  slug             String   @unique
  activo           Boolean  @default(true)
  solo_super_admin Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  locales              Local[]
  user_app_roles       UserAppRole[]
  disponibilidad_tipos DisponibilidadTipo[]
  detalle_tipos        DetalleTipo[]
  local_access         UserLocalAccess[]
  usage                UserAppUsage[]
  clientes             Cliente[]
  documentos           Documento[]
  inspeccion_folios    InspeccionFolio[]

  @@map("apps")
}

model Local {
  id                 String     @id @default(uuid())
  nombre             String
  direccion          String?
  telefono           String?
  activo             Boolean    @default(true)
  id_app             String
  id_proveedor       String?
  logo_url           String?
  maps_url           String?
  menu_url           String?
  mail_facturas      String?
  tipo_local         TipoLocal?
  // Descuento automatico que se aplica al cargar un MovStock, en porcentaje
  // sobre el neto. Es 30% para todos salvo que el local tenga otro pactado, por
  // eso el default vive en la base: los locales que ya existen quedan en 30 sin
  // tener que actualizar nada. NULL nunca deberia darse gracias al default,
  // pero si aparece el codigo lo trata como el 30 general.
  descuento_movstock Decimal?   @default(30) @db.Decimal(5, 2)
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  app               App                   @relation(fields: [id_app], references: [id])
  proveedor         Proveedor?            @relation(fields: [id_proveedor], references: [id])
  cajas             Caja[]
  pagos             Pago[]
  pdps              Pdp[]
  arqueos           Arqueo[]
  local_access      UserLocalAccess[]
  detalle_tipos     DetalleTipo[]
  disponibilidades  LocalDisponibilidad[]
  movimientos_cm    MovimientoCM[]
  documentos        Documento[]
  inspeccion_folios InspeccionFolio[]

  @@map("locales")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  nombre        String
  password_hash String?
  google_id     String?   @unique
  avatar_url    String?
  activo        Boolean   @default(true)
  // Ultimo ingreso exitoso. Pasados DIAS_INACTIVIDAD dias (ver lib/inactividad)
  // la contrasena deja de servir y hay que pedir que la reseteen.
  //
  // Arranca en NULL para todos los usuarios que ya existen y NULL NO bloquea:
  // significa "todavia no lo sabemos" y el primer login lo completa. Resetear
  // la contrasena tambien lo vuelve a NULL, que es como se destraba una cuenta.
  last_login    DateTime?

  // Datos de la persona. Todos opcionales: los 60 usuarios que ya existen no los
  // tienen y no hay por que trabar el login hasta que alguien los complete.
  //
  // departamento se valida contra la lista de lib/datosUsuario.js, no es texto libre
  // (ver ahi por que la lista esta en codigo y no como enum de Postgres). puesto si es
  // texto: es como se describe el cargo de cada uno.
  //
  // "puesto" es lo que en pantalla se llama "Rol". No se llama rol en el codigo
  // porque rol ya es el rol de permisos (super_admin, admin, cajero...).
  //
  // No hay columna de equipo a proposito: con el departamento y el puesto ya se sabe
  // a que equipo pertenece cada uno, y un tercer campo para deducir lo mismo es un
  // campo mas que queda sin cargar.
  departamento String?
  puesto       String?
  // Fecha pura, sin hora: un cumpleanos no tiene hora, y guardarlo como timestamp
  // lo corre un dia segun la zona (ya paso con 2076 cajas migradas a medianoche UTC).
  fecha_nac    DateTime? @db.Date

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_app_roles     UserAppRole[]
  user_permissions   UserPermission[]
  cajas_creadas      Caja[]            @relation("CajaCreatedBy")
  pagos_creados      Pago[]            @relation("PagoCreatedBy")
  pdps_creados       Pdp[]             @relation("PdpCreatedBy")
  arqueos_creados    Arqueo[]          @relation("ArqueoCreatedBy")
  local_access       UserLocalAccess[]
  audits             Audit[]           @relation("AuditUser")
  app_usage          UserAppUsage[]
  activity_logs      ActivityLog[]     @relation("ActivityLogUser")
  filtro_presets     FiltroPreset[]    @relation("FiltroPresetUser")
  notificaciones     Notificacion[]    @relation("NotificacionUser")
  mov_cm_creados     MovimientoCM[]    @relation("MovimientoCMCreatedBy")
  mov_cm_recibidos   MovimientoCM[]    @relation("MovimientoCMRecibidaBy")
  documentos_creados Documento[]       @relation("DocumentoCreatedBy")
  folios_creados     InspeccionFolio[] @relation("FolioCreatedBy")
  folios_editados    InspeccionFolio[] @relation("FolioUpdatedBy")

  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?

  user_app_roles   UserAppRole[]
  role_permissions RolePermission[]

  @@map("roles")
}

model Module {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  role_permissions RolePermission[]
  user_permissions UserPermission[]

  @@map("modules")
}

model UserLocalAccess {
  id       String @id @default(uuid())
  id_user  String
  id_app   String
  id_local String

  user  User  @relation(fields: [id_user], references: [id])
  app   App   @relation(fields: [id_app], references: [id])
  local Local @relation(fields: [id_local], references: [id])

  @@unique([id_user, id_app, id_local])
  @@map("user_local_access")
}

model RolePermission {
  id         String  @id @default(uuid())
  id_role    String
  id_module  String
  can_view   Boolean @default(false)
  can_create Boolean @default(false)
  can_edit   Boolean @default(false)
  can_delete Boolean @default(false)

  role   Role   @relation(fields: [id_role], references: [id])
  module Module @relation(fields: [id_module], references: [id])

  @@unique([id_role, id_module])
  @@map("role_permissions")
}

model UserAppRole {
  id      String  @id @default(uuid())
  id_user String
  id_app  String? // null = acceso global (super_admin / dcsmart)
  id_role String

  user User @relation(fields: [id_user], references: [id])
  app  App? @relation(fields: [id_app], references: [id])
  role Role @relation(fields: [id_role], references: [id])

  @@unique([id_user, id_app])
  @@map("user_app_roles")
}

model UserAppUsage {
  id_user      String
  id_app       String
  last_used_at DateTime @default(now())

  user User @relation(fields: [id_user], references: [id])
  app  App  @relation(fields: [id_app], references: [id])

  @@id([id_user, id_app])
  @@map("user_app_usage")
}

model UserPermission {
  id         String  @id @default(uuid())
  id_user    String
  id_module  String
  can_view   Boolean @default(false)
  can_create Boolean @default(false)
  can_edit   Boolean @default(false)
  can_delete Boolean @default(false)

  user   User   @relation(fields: [id_user], references: [id])
  module Module @relation(fields: [id_module], references: [id])

  @@unique([id_user, id_module])
  @@map("user_permissions")
}

model Rubro {
  id     String @id @default(uuid())
  nombre String @unique

  rubcats RubCat[]

  @@map("rubros")
}

model Categoria {
  id     String @id @default(uuid())
  nombre String @unique

  rubcats RubCat[]

  @@map("categorias")
}

model RubCat {
  id            String  @id @default(uuid())
  id_cat        String
  id_rub        String
  cuenta        String?
  // `tipo` y `clasificacion` son CONTABLES (Pasivo Corriente, Costo de Ventas...), no
  // tienen nada que ver con el tipo de local. Se aclara porque el nombre invita a
  // confundirlos con `tipos_afines`.
  tipo          String?
  costo         String?
  clasificacion String?

  // Afinidad con el tipo de local, igual que en Proveedor y por la misma razon: ordenar
  // el buscador para que un local gastronomico vea primero los rubros que usa. NUNCA
  // filtra -- cualquier local puede elegir cualquier rubro.
  //
  // El default en la base es obligatorio, no cosmetico: sin el las filas nuevas quedan en
  // NULL y en Postgres `NOT (NULL OR false)` da NULL, asi que el rubro desapareceria de
  // las dos mitades del buscador. Es el bug que ya paso con proveedores (ver
  // lib/afinidadProveedor.js).
  tipos_afines TipoLocal[] @default([])
  // Rubros transversales que sirven a cualquier tipo de local (impuestos, bancos,
  // alquileres). Mismo criterio que `Proveedor.es_general`.
  es_general   Boolean     @default(false)

  categoria   Categoria   @relation(fields: [id_cat], references: [id])
  rubro       Rubro       @relation(fields: [id_rub], references: [id])
  pagos       Pago[]
  proveedores Proveedor[]

  @@unique([id_cat, id_rub])
  @@map("rubcat")
}

// A nombre de quién se generó un gasto. Es lo contrario de `Proveedor` -- a quién se
// le paga -- y no se mezclan: un mismo Pago puede tener los dos, el proveedor al que
// se le pagó y el cliente que lo debe.
//
// A diferencia de Proveedor, que es un catálogo global, un Cliente pertenece a un
// grupo: mismo patrón que DetalleTipo (ver routes/detalle_tipos.js). Un cliente de un
// grupo no tiene por qué existir en otro, y si el mismo cliente real le compra a dos
// grupos se carga en los dos -- son cuentas corrientes separadas.
model Cliente {
  id            String   @id @default(uuid())
  id_app        String
  nombre        String?
  razon_social  String?
  cuit          String?
  telefono      String?
  mail          String?
  observaciones String?
  activo        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  app           App           @relation(fields: [id_app], references: [id])
  pagos         Pago[]
  // La otra mitad de la cuenta corriente: lo que se le cargó a la cuenta desde una
  // caja (una venta que se anotó en su cuenta en vez de cobrarse). Ver
  // lib/cuentaCorrienteCaja.js.
  caja_detalles CajaDetalle[]

  @@index([id_app])
  @@map("clientes")
}

// ─── DOCUMENTOS ──────────────────────────────────────────────────────────────
//
// Archivos y links ordenados por tipo (contratos, habilitaciones, reportes...),
// agrupados por grupo y local.

// Los tipos se administran desde la app, no son una lista en codigo: el "etc" de
// contratos/habilitaciones/reportes va a crecer y agregar uno no puede ser un deploy.
//
// Son globales, sin id_app: un contrato es un contrato en todos los grupos, y con un
// tipo por grupo la misma cosa aparecia con cinco nombres distintos.
model TipoDocumento {
  id     String  @id @default(uuid())
  nombre String  @unique
  // Clave del catalogo de iconos (lib/iconosDocumento.js), no un emoji ni una clase
  // CSS: el formulario ofrece los que existen y el backend rechaza cualquier otra.
  icono  String  @default("documento")
  // Para ordenar la lista a mano: los que se usan todos los dias arriba.
  orden  Int     @default(0)
  activo Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  documentos Documento[]

  @@index([activo, orden])
  @@map("tipo_documento")
}

model Documento {
  id           String  @id @default(uuid())
  id_tipo      String
  // El grupo es obligatorio y el local no: un contrato marco o una habilitacion de
  // sociedad son del grupo entero, no de una sucursal. Sin local = lo ve todo el grupo.
  id_app       String
  id_local     String?
  // Opcional: sirve para encontrar "todo lo que tengo firmado con este proveedor".
  id_proveedor String?

  nombre  String
  detalle String?
  // Un documento puede ser un link en vez de archivos (una carpeta de Drive, un
  // sistema externo). Puede tener las dos cosas: el link y el PDF firmado.
  url     String?

  // Quien lo ve DENTRO de la app. En false lo ven solo los roles internos; en true,
  // cualquiera que entre a ese local (incluido cajero). Es distinto del link publico
  // de abajo, que sale de la app.
  visible_todos Boolean @default(false)

  // Link para compartir SIN login (mandarle una habilitacion a un inspector). Nace en
  // null: existe solo si alguien lo genero, y se revoca volviendolo a null. El token es
  // el secreto, asi que es unico y largo (ver lib/tokenPublico.js).
  token_publico   String?   @unique
  token_creado_at DateTime?

  // Vencimiento (habilitaciones, seguros). Fecha pura, sin hora, por lo mismo que
  // fecha_nac en User: un vencimiento no tiene hora y con hora se corre un dia.
  vence         DateTime? @db.Date
  // Hasta cuando ya se aviso. Evita repetir el mismo aviso en cada listado; se limpia
  // si cambia la fecha de vencimiento, porque ahi el aviso viejo ya no aplica.
  avisado_hasta DateTime?

  id_created_by String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tipo       TipoDocumento      @relation(fields: [id_tipo], references: [id])
  app        App                @relation(fields: [id_app], references: [id])
  local      Local?             @relation(fields: [id_local], references: [id])
  proveedor  Proveedor?         @relation(fields: [id_proveedor], references: [id])
  created_by User?              @relation("DocumentoCreatedBy", fields: [id_created_by], references: [id])
  archivos   DocumentoArchivo[]

  // El listado siempre filtra por grupo y casi siempre por local: es la consulta de la
  // pantalla. Las otras tres cubren las FK, que Prisma no indexa solas (ver el PR #114,
  // donde cuatro FK sin indice escaneaban tablas enteras).
  @@index([id_app, id_local])
  @@index([id_tipo])
  @@index([id_proveedor])
  @@index([id_created_by])
  // Los que vencen pronto, para el barrido de avisos.
  @@index([vence])
  @@map("documentos")
}

model DocumentoArchivo {
  id              String   @id @default(uuid())
  id_documento    String
  // gs://bucket/carpeta/archivo.pdf -- se sirve por el proxy de lectura, igual que los
  // adjuntos de pagos. Nunca se expone la URL de GCS.
  gs_path         String
  // 'foto' o 'pdf': decide si se muestra en el visor de imagenes o se abre el PDF.
  tipo            String
  // Como se llamaba el archivo que subieron. En GCS el nombre es un timestamp, asi que
  // sin esto la lista muestra "1786445361010-x7f2.pdf" y nadie sabe cual es cual.
  nombre_original String?
  orden           Int      @default(0)
  created_at      DateTime @default(now())

  documento Documento @relation(fields: [id_documento], references: [id], onDelete: Cascade)

  @@index([id_documento, orden])
  @@map("documento_archivos")
}

// ─── CARPETA DE INSPECCIONES ─────────────────────────────────────────────────
//
// Vive dentro del módulo Documentos pero NO es un Documento: un documento es un
// archivo con nombre y vencimiento, y esto es una planilla de control. Cada local
// tiene su carpeta -- la "carpeta" no es una fila, es la agrupación por local -- y
// adentro los folios, que son las líneas de control con su concepto y su estado.
//
// El orden lo maneja la persona (se arrastra en la pantalla), así que `folio` es un
// dato editable y no un autoincremental.
//
// NO lleva `@@unique([id_local, folio])` a propósito: reordenar con esa restricción
// obliga a un pase intermedio con números provisorios para no chocar mientras se
// escribe. El orden se reescribe entero en una transacción (ver PUT /orden), que da
// la misma garantía sin el baile de valores temporales.
model InspeccionFolio {
  id       String @id @default(uuid())
  id_app   String
  // La carpeta. Obligatorio: un folio sin local no pertenece a ninguna carpeta.
  id_local String

  // Posición en la planilla, alterable por quien la ordena.
  folio    Int
  concepto String
  estado   EstadoFolio @default(FALTA)

  // Las tres fechas del folio, todas DATE y no timestamp: son días de calendario, y como
  // timestamp se corren un día en GMT-3 (ya pasó con 2076 cajas migradas a medianoche UTC).
  //
  //   fecha_emision -> cuándo se emitió el certificado / la habilitación
  //   periodo       -> a qué mes corresponde. Se guarda el día 1 del mes, igual que
  //                    Pago.periodo, y en pantalla se muestra MM/AAAA.
  //   vence         -> cuándo se vence. Informativo: NO define el estado, que lo elige
  //                    una persona (decisión del usuario, 13/08). Un folio puede estar OK
  //                    sin fecha, o tener fecha y estar EN_ESPERA porque falta el papel.
  fecha_emision DateTime? @db.Date
  periodo       DateTime? @db.Date
  vence         DateTime? @db.Date
  observaciones String?

  id_created_by String?
  // Quién tocó el folio por última vez. `updated_at` ya decía CUÁNDO; sin el quién, la
  // columna de última actualización no sirve para preguntarle a nadie.
  id_updated_by String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  app        App            @relation(fields: [id_app], references: [id])
  local      Local          @relation(fields: [id_local], references: [id])
  created_by User?          @relation("FolioCreatedBy", fields: [id_created_by], references: [id])
  updated_by User?          @relation("FolioUpdatedBy", fields: [id_updated_by], references: [id])
  archivos   FolioArchivo[]

  // La planilla se pide siempre por local y ordenada por folio.
  @@index([id_local, folio])
  @@index([id_app])
  @@map("inspeccion_folios")
}

// Mismo diseño que DocumentoArchivo, y por el mismo motivo: varios archivos por
// folio (el certificado, la foto, el comprobante de pago) con su propio orden.
model FolioArchivo {
  id       String @id @default(uuid())
  id_folio String

  gs_path         String
  tipo            String
  nombre_original String?
  orden           Int      @default(0)
  created_at      DateTime @default(now())

  folio InspeccionFolio @relation(fields: [id_folio], references: [id], onDelete: Cascade)

  @@index([id_folio, orden])
  @@map("folio_archivos")
}

// Los seis estados que pidió el usuario. Se eligen a mano: VENCIDO y PROX_VENC no se
// deducen de `vence` aunque se podría, porque el criterio de "próximo" lo pone quien
// controla la carpeta y no siempre coincide con una cantidad de días.
enum EstadoFolio {
  OK
  VENCIDO
  EN_ESPERA @map("EN ESPERA")
  FALTA
  REVISAR
  PROX_VENC @map("PROX VENC")

  @@map("estado_folio")
}

model Proveedor {
  id            String   @id @default(uuid())
  nombre        String?
  razon_social  String?
  cuit          String?
  banco         String?
  cbu           String?
  alias         String?
  direccion_url String?
  detalle_direc String?
  telefono      String?
  mail_contacto String?
  mail_envio    String?
  tag           String?
  cuenta        String?
  observaciones String?
  tipo_local    String?
  tipo          String?
  id_rubcat     String?
  plazo         Int?
  activo        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Afinidad con el tipo de local, para ordenar el buscador de proveedores:
  // los afines y los generales primero. Nunca filtra, solo ordena -- un local
  // siempre puede elegir cualquier proveedor.
  //
  // `tipos_afines` es distinto del viejo `tipo_local` (texto libre, hoy con
  // 4014 registros en "GASTRONOMICO" cargados en una migracion). Se dejan los
  // dos: el viejo sigue siendo el dato historico y este es el que ordena.
  // Vacio = sin clasificar, va al final.
  // El default en la base es obligatorio, no cosmético: sin él las filas nuevas
  // quedan en NULL y en Postgres `NOT (NULL OR false)` da NULL, así que el
  // proveedor desaparece de las DOS mitades del buscador (ver lib/afinidadProveedor.js,
  // que documenta el bug que eso causó). Se declara acá para que `migrate diff` no
  // proponga quitarlo: Prisma no lo infiere de `TipoLocal[]`.
  tipos_afines TipoLocal[] @default([])
  es_general   Boolean     @default(false) // servicios transversales: Aysa, Metrogas, AFIP, bancos

  rubcat     RubCat?     @relation(fields: [id_rubcat], references: [id])
  pagos      Pago[]
  locales    Local[]
  documentos Documento[]

  // Ver el comentario en Impuesto: las FK necesitan su índice a mano.
  @@index([id_rubcat])
  @@map("proveedores")
}

model MetodoPago {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  caja_movimientos CajaMovimiento[]
  pagos            Pago[]

  @@map("metodos_pago")
}

model Caja {
  id            String     @id @default(uuid())
  nro_turno     String?
  tipo_turno    TipoTurno?
  fecha_inicio  DateTime
  fecha_cierre  DateTime?
  id_local      String
  cajero        String?
  total         Decimal?   @db.Decimal(12, 2)
  efectivo      Decimal?   @db.Decimal(12, 2)
  fiscal        Decimal?   @db.Decimal(12, 2)
  comensales    Int?
  tickets       Int?
  observaciones String?
  foto_url      String?
  id_externo    String?
  origin        Origin     @default(DCSMART)
  created_by    String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  local       Local            @relation(fields: [id_local], references: [id])
  creador     User?            @relation("CajaCreatedBy", fields: [created_by], references: [id])
  movimientos CajaMovimiento[]
  detalles    CajaDetalle[]

  // Idempotencia de los syncs (TapTap/Fudo): el mismo turno/día externo no
  // puede existir dos veces para un local+origen. Los syncs ya deduplican por
  // código, pero con 14 locales de Fudo una carrera o un bug lo pasarían por
  // alto en silencio — esto lo hace imposible a nivel base. Postgres trata los
  // NULL como distintos, así que las cajas manuales (id_externo null) no
  // chocan entre sí. Reemplaza al índice de consulta [id_local, id_externo]:
  // el índice único cubre ese prefijo.
  @@unique([id_local, id_externo, origin])
  @@index([id_local, fecha_inicio])
  @@map("cajas")
}

// Las disponibilidades que se cuentan en un arqueo: la plata que el local
// tiene y NO está en el cajón — Mercado Pago, dólares, la cuenta del banco.
//
// Antes salían del catálogo de las cajas (DetalleTipo), que es de otra cosa: el
// combo ofrecía "Salón", "Rappi" y "Online" como si fueran disponibilidades, y
// en producción hay arqueos con esos conceptos cargados. Además nada decía qué
// le corresponde a cada local, así que cada arqueo se armaba de memoria: medido
// el 2026-08-20, un local carga cuatro conceptos, otro dos, y GRAN-DANZON tiene
// 19 arqueos con ninguno.
//
// El catálogo es POR GRUPO: los bancos y billeteras de un cliente no son los
// del otro. Qué tiene activo cada local vive en LocalDisponibilidad.
model DisponibilidadTipo {
  id      String  @id @default(uuid())
  id_app  String
  nombre  String
  // Para agrupar en la pantalla y en el arqueo: MP, banco, efectivo en otra
  // moneda, otro. No cambia ningún cálculo, ordena la lectura.
  familia String  @default("otro")
  activo  Boolean @default(true)
  // El orden con que se listan al cargar. Dos conceptos con el mismo número
  // desempatan por nombre.
  orden   Int     @default(100)

  app             App                   @relation(fields: [id_app], references: [id])
  locales         LocalDisponibilidad[]
  arqueo_detalles ArqueoDetalle[]

  @@unique([nombre, id_app])
  @@map("disponibilidad_tipos")
}

// Qué disponibilidades tiene activas un local: es la lista que el arqueo le
// pide cargar. Se define al dar de alta el local (y se corrige después desde
// Locales), no al hacer el arqueo — el que cuenta la plata no tiene que
// acordarse de qué cuentas tiene el local.
model LocalDisponibilidad {
  id       String @id @default(uuid())
  id_local String
  id_tipo  String
  // Pisa el orden del catálogo cuando un local quiere el suyo.
  orden    Int?

  local Local              @relation(fields: [id_local], references: [id], onDelete: Cascade)
  tipo  DisponibilidadTipo @relation(fields: [id_tipo], references: [id], onDelete: Cascade)

  @@unique([id_local, id_tipo])
  @@index([id_local])
  @@map("local_disponibilidades")
}

model DetalleTipo {
  id            String  @id @default(uuid())
  id_app        String
  id_local      String?
  nombre        String
  clasificacion String  @default("otro")
  activo        Boolean @default(true)

  app             App             @relation(fields: [id_app], references: [id])
  local           Local?          @relation(fields: [id_local], references: [id])
  detalles        CajaDetalle[]
  arqueo_detalles ArqueoDetalle[]

  @@unique([nombre, id_app])
  @@map("detalle_tipos")
}

model Arqueo {
  id            String   @id @default(uuid())
  id_local      String
  fecha         DateTime
  caja_fuerte   Decimal  @db.Decimal(12, 2)
  cofre         Decimal  @db.Decimal(12, 2)
  adicion       Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  ingresos      Decimal  @db.Decimal(12, 2)
  gastos        Decimal  @db.Decimal(12, 2)
  comprobacion  Decimal  @db.Decimal(12, 2)
  observaciones String?
  created_by    String?
  created_at    DateTime @default(now())

  local    Local           @relation(fields: [id_local], references: [id])
  creador  User?           @relation("ArqueoCreatedBy", fields: [created_by], references: [id])
  detalles ArqueoDetalle[]

  @@index([id_local, fecha])
  @@map("arqueos")
}

model ArqueoDetalle {
  id                String   @id @default(uuid())
  id_arqueo         String
  id_tipo           String?
  // La disponibilidad del catálogo nuevo. `id_tipo` (el catálogo de cajas) se
  // conserva porque los 63 detalles ya cargados apuntan ahí: se lee uno u otro
  // según cuál tenga la fila, y el histórico no se toca.
  id_disponibilidad String?
  nombre            String?
  monto             Decimal  @db.Decimal(12, 2)
  created_at        DateTime @default(now())

  arqueo         Arqueo              @relation(fields: [id_arqueo], references: [id])
  detalle_tipo   DetalleTipo?        @relation(fields: [id_tipo], references: [id])
  disponibilidad DisponibilidadTipo? @relation(fields: [id_disponibilidad], references: [id])

  @@map("arqueo_detalles")
}

model CajaDetalle {
  id            String   @id @default(uuid())
  id_caja       String
  tipo          String?
  // Cantidad de operaciones que componen la linea (los groupCount de TapTap:
  // 23 cobros con Credito). Vino de los movimientos al unificar; opcional.
  cantidad      Int?
  id_tipo       String?
  // A qué cuenta corriente se le cargó esta línea. Es el equivalente en caja del
  // `id_cliente` de Pago: una venta que en vez de cobrarse quedó anotada en la cuenta
  // de alguien. Opcional -- la enorme mayoría de los detalles no son de cuenta
  // corriente. Ver lib/cuentaCorrienteCaja.js.
  id_cliente    String?
  nombre        String?
  monto         Decimal  @db.Decimal(12, 2)
  observaciones String?
  created_at    DateTime @default(now())

  caja         Caja         @relation(fields: [id_caja], references: [id])
  detalle_tipo DetalleTipo? @relation(fields: [id_tipo], references: [id])
  cliente      Cliente?     @relation(fields: [id_cliente], references: [id])

  // Postgres NO indexa las FK solo, y Prisma tampoco: sin estos índices toda
  // consulta por id_caja escaneaba la tabla entera. El listado de cajas trae
  // los detalles de cada caja de la página para calcular el cuadre y el total,
  // asi que eran dos escaneos completos por pantalla. Medido: 3,2 ms -> 0,46 ms.
  @@index([id_caja])
  @@index([id_tipo])
  // La ficha de un cliente pide sus detalles de caja: sin índice, escaneo completo de
  // caja_detalles (la tabla más grande del sistema) por cada apertura de ficha. Mismo
  // motivo que el índice [id_cliente, fecha] de Pago.
  @@index([id_cliente])
  @@map("caja_detalles")
}

enum Origin {
  DCSMART
  TAPTAP
  FFUDO

  @@map("origin")
}

enum TipoTurno {
  MANANA    @map("Mañana")
  TARDE     @map("Tarde")
  NOCHE     @map("Noche")
  TRASNOCHE @map("Trasnoche")
  EVENTO    @map("Evento")
  OTROS     @map("Otros")

  @@map("tipo_turno")
}

// Rubro del local. Los valores se guardan con acento porque dcsmart-analisis
// lee esta misma base sin un contrato compartido: conviene que el dato sea
// legible por si solo, igual que TipoTurno.
enum TipoLocal {
  GASTRONOMIA  @map("Gastronomía")
  INDUMENTARIA @map("Indumentaria")
  ARQUITECTURA @map("Arquitectura")
  INMOBILIARIO @map("Inmobiliario")
  MULTIMEDIA   @map("Multimedia")

  @@map("tipo_local")
}

enum TipoMovimiento {
  INICIAL
  INGRESO
  GASTO
  COBRO
  RETIRO
  VACIADO
  EGRESO

  @@map("tipo_movimiento")
}

model CajaMovimiento {
  id        String         @id @default(uuid())
  tipo      TipoMovimiento
  id_metodo String?
  monto     Decimal        @db.Decimal(12, 2)
  id_caja   String
  cantidad  Int?

  caja        Caja        @relation(fields: [id_caja], references: [id])
  metodo_pago MetodoPago? @relation(fields: [id_metodo], references: [id])

  // Ver el comentario en CajaDetalle: mismo motivo. Medido: 2,1 ms -> 0,44 ms.
  @@index([id_caja])
  @@map("caja_movimientos")
}

model Pago {
  id             String    @id @default(uuid())
  nro_ord        Int?
  fecha          DateTime?
  id_proveedor   String?
  id_rubcat      String?
  id_tipo        TipoPago?
  pv             Int?
  nro            BigInt?
  importe_neto   Decimal?  @db.Decimal(12, 2)
  descuento      Decimal?  @db.Decimal(12, 2)
  importe        Decimal?  @db.Decimal(12, 2)
  id_metodo      String?
  cashflow       DateTime?
  observaciones  String?
  pagado         Boolean   @default(false)
  fecha_pago     DateTime?
  estado_op      EstadoOp?
  foto_url       String?
  pdf_url        String?
  periodo        DateTime?
  ingresa_egreso Boolean   @default(true)
  periodico      Boolean   @default(false)
  cargado_con_ia Boolean   @default(false)
  id_local       String?
  created_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  id_pdp     String?
  id_eventos String?
  id_cheque  String?

  // A nombre de quién se generó el gasto. Solo se carga cuando estado_op es
  // CTA_CTE_CLI: es la regla de negocio del módulo de clientes y la valida el
  // backend, no solo el formulario. Reemplaza a `id_ctacte`, que quedó reservada y
  // nunca se usó (cero referencias en código) -- y cuyo nombre además evocaba el
  // CUENTA_CTE de proveedores, que significa lo contrario.
  id_cliente String?

  // INTERCOMPANY: la op que originó esta copia. Cuando se manda plata de un
  // local a otro del MISMO grupo, la op original queda como egreso en el local
  // que envía y acá nace su espejo como ingreso en el que recibe. Tener el
  // vínculo como FK (y no solo un texto en observaciones) es lo que permite
  // saber que ya se envió, mostrar de dónde vino y revertir sin adivinar.
  id_pago_origen String?

  proveedor     Proveedor?    @relation(fields: [id_proveedor], references: [id])
  rubcat        RubCat?       @relation(fields: [id_rubcat], references: [id])
  metodo_pago   MetodoPago?   @relation(fields: [id_metodo], references: [id])
  local         Local?        @relation(fields: [id_local], references: [id])
  creador       User?         @relation("PagoCreatedBy", fields: [created_by], references: [id])
  pdp           Pdp?          @relation(fields: [id_pdp], references: [id])
  cliente       Cliente?      @relation(fields: [id_cliente], references: [id])
  impuestos     Impuesto[]
  multimoneda   MultiMoneda[]
  // Solo existe si la op es de tipo CM y alguien la gestionó en Caja Mayor.
  movimiento_cm MovimientoCM?

  // Las dos puntas del envío intercompany. `origen` es la op del local que
  // mandó; `copias` son los espejos (hoy uno, la relación soporta más).
  origen Pago?  @relation("PagoIntercompany", fields: [id_pago_origen], references: [id])
  copias Pago[] @relation("PagoIntercompany")

  @@index([id_local, fecha])
  @@index([pagado])
  @@index([estado_op])
  // La cuenta corriente de un cliente pide sus pagos ordenados por fecha. Prisma no
  // indexa las FK solo y ya hubo cinco casos de lentitud por eso (ver PR #114).
  @@index([id_cliente, fecha])
  // Para responder "¿esta op ya se envió?" sin escanear la tabla: es la
  // pregunta que hace la pantalla de Intercompany por cada fila que lista.
  @@index([id_pago_origen])
  @@map("pagos")
}

enum TipoPago {
  A
  B
  C
  CM
  DC_1 @map("DC (1)")
  DC_2 @map("DC (2)")
  DDJJ
  FF
  LF
  M
  NCA
  NCB
  NDA
  ND
  NDC
  STK
  X

  @@map("tipo_pago")
}

// CUENTA_CTE y CTA_CTE_CLI apuntan en direcciones opuestas y no hay que confundirlos:
//   CUENTA_CTE  -> la empresa todavía no le pagó a ESE PROVEEDOR (es la "Deuda" del
//                  dashboard de PDP)
//   CTA_CTE_CLI -> el gasto se generó a nombre de un CLIENTE, que se lo debe a la
//                  empresa
// Por eso es un estado nuevo y no se reusa el existente.
enum EstadoOp {
  CAJA
  CUENTA_CTE  @map("CUENTA CTE")
  MP_PDP      @map("MP PDP")
  PDP
  CTA_CTE_CLI @map("CTA CTE CLI")

  @@map("estado_op")
}

model Impuesto {
  id      String       @id @default(uuid())
  id_pago String
  tipo    TipoImpuesto
  monto   Decimal      @db.Decimal(12, 2)

  pago Pago @relation(fields: [id_pago], references: [id])

  // El más importante de todos: sin este índice, cada lectura de los impuestos
  // de un pago escaneaba las 30 mil filas de la tabla para devolver dos.
  // Medido: 3,4 ms -> 0,10 ms, y 352 páginas leídas -> 4.
  @@index([id_pago])
  @@map("impuestos")
}

model MultiMoneda {
  id      String   @id @default(uuid())
  id_pago String
  tipo    String
  tdc     Decimal  @db.Decimal(12, 4)
  monto   Decimal  @db.Decimal(12, 2)
  fecha   DateTime @default(now())

  pago Pago @relation(fields: [id_pago], references: [id])

  @@unique([id_pago])
  @@map("multimoneda")
}

enum TipoImpuesto {
  IVA21
  IVA27
  IVA10
  RETENCION
  // PERCEPCION queda por los datos historicos (las migraciones de AppSheet
  // juntaban Perc. IVA y Perc. IIBB en un solo tipo); el alta ya no lo ofrece.
  PERCEPCION
  IMP_INTERNOS
  PERC_IVA
  PERC_IIBB

  @@map("tipo_impuesto")
}

model Audit {
  id            String    @id @default(uuid()) @db.Uuid
  id_registro   String
  tabla         String
  tipo          String
  accion        String    @default("auditado")
  aprobado      Boolean?  @default(false)
  vigente       Boolean   @default(true)
  audit_dc      Boolean   @default(false)
  id_user       String?
  fecha         DateTime?
  observaciones String?
  created_at    DateTime? @default(now())
  updated_at    DateTime? @default(now())

  user User? @relation("AuditUser", fields: [id_user], references: [id])

  @@index([tabla, id_registro, vigente])
  @@index([tabla, id_registro, fecha])
  @@map("audits")
}

// Log de actividad CRUD (crear/editar/eliminar), solo visible para
// super_admin. Genérico por `tabla` para poder extenderse a otras entidades
// más adelante; hoy solo se escribe para `tabla = 'pagos'`. `snapshot` guarda
// el registro completo en formato JSON en el momento de la acción -- para
// "eliminado" es el último estado antes del hard delete (el borrado en sí no
// cambia, esto es solo el rastro de auditoría).
model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  tabla       String
  id_registro String
  id_local    String
  accion      String // 'creado' | 'editado' | 'eliminado'
  id_user     String?
  fecha       DateTime @default(now())
  snapshot    Json
  // Por que se hizo. Hoy lo escribe quien elimina una caja o una op: el snapshot dice QUE
  // habia, pero no por que se borro, y eso es lo que se pregunta despues. Nullable: los
  // registros anteriores no lo tienen y el campo no es obligatorio.
  motivo      String?

  user User? @relation("ActivityLogUser", fields: [id_user], references: [id])

  @@index([tabla, id_local, fecha])
  @@index([id_registro])
  @@map("activity_log")
}

model Pdp {
  id              String    @id @default(uuid())
  id_local        String
  created_by      String?
  created_at      DateTime  @default(now())
  ultima_descarga DateTime?
  pdf_url         String
  cantidad_pagos  Int
  total           Decimal   @db.Decimal(12, 2)

  local   Local  @relation(fields: [id_local], references: [id])
  creador User?  @relation("PdpCreatedBy", fields: [created_by], references: [id])
  pagos   Pago[]

  @@index([id_local, created_at])
  @@map("pdp")
}

model TapTapSyncRun {
  id          String    @id @default(uuid())
  started_at  DateTime  @default(now())
  finished_at DateTime?
  resultado   Json? // { "kjhggtrer": { turnosNuevos: 3, error: null }, ... } por id_local
  ok          Boolean   @default(true)

  @@map("taptap_sync_runs")
}

// Registro de corridas del job de sincronizacion de cajas desde Fudo.
model FudoSyncRun {
  id          String    @id @default(uuid())
  started_at  DateTime  @default(now())
  finished_at DateTime?
  resultado   Json? // { "LTRXNBIR": { cajasNuevas: 1, cajasActualizadas: 3 }, ... } por id_local
  ok          Boolean   @default(true)

  @@map("fudo_sync_runs")
}

// Filtros guardados por usuario ("mis filtros") de las pantallas de listado.
// `modulo` existe para que la misma tabla sirva a pagos y despues a cajas sin
// migrar de nuevo. El tope de 5 por usuario y modulo se valida en la ruta, no
// en el esquema: Postgres no puede expresar "maximo N filas por grupo" sin un
// trigger, y un trigger seria mas dificil de encontrar que la validacion.
// Avisos dirigidos a un usuario. Hoy solo se emiten cuando alguien revierte una
// auditoria: el auditor tiene que enterarse de que le desauditaron algo sin
// depender de que revise la pantalla de Auditorias.
//
// `tabla` + `id_registro` es el mismo patron polimorfico que usa Audit, y por el
// mismo motivo: el aviso puede apuntar a un pago o a una caja, y no se le puede
// poner una FK a las dos. Sirven para armar el link, no para integridad.
model Notificacion {
  id          String    @id @default(uuid())
  id_user     String
  tipo        String
  titulo      String
  cuerpo      String?
  tabla       String?
  id_registro String?
  id_local    String?
  leida       Boolean   @default(false)
  // `hecha` es distinto de `leida`: leida se marca sola al abrir el aviso, asi que no
  // dice si la tarea se resolvio. Un aviso de desauditoria es alguien pidiendo que
  // revises algo, y eso se cierra cuando lo hiciste, no cuando lo miraste.
  hecha       Boolean   @default(false)
  hecha_at    DateTime?
  created_at  DateTime  @default(now())

  user User @relation("NotificacionUser", fields: [id_user], references: [id])

  // id_user va primero en los tres indices: todas las consultas son "las mias".
  // El primero cubre ademas la FK, que Prisma no indexa sola -- ver el PR #114,
  // donde justamente cuatro FK sin indice escaneaban tablas enteras.
  @@index([id_user, leida])
  // El contador del sidebar pregunta "cuantas me faltan": sin este indice escanea
  // todas las notificaciones del usuario en cada refresco.
  @@index([id_user, hecha])
  @@index([id_user, created_at])
  @@map("notificaciones")
}

model FiltroPreset {
  id         String   @id @default(uuid())
  id_user    String
  modulo     String // 'pagos' | 'cajas'
  nombre     String
  filtros    Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation("FiltroPresetUser", fields: [id_user], references: [id], onDelete: Cascade)

  @@unique([id_user, modulo, nombre])
  @@index([id_user, modulo])
  @@map("filtro_presets")
}

// ─── CAJA MAYOR ──────────────────────────────────────────────────────────────
// Reemplazo del AppSheet DC-CAJA MAYOR (app CM-PERROS-334067). Solo super_admin,
// sobre TODOS los locales de todos los grupos a la vez -- ver routes/caja_mayor.js.
//
// Cuando se carga un Pago con id_tipo = 'CM', se COPIA acá como un movimiento con
// estado ENVIADA: el local mandó la plata al CM y el CM después confirma que la
// recibió. La copia es el registro del envío, y queda relacionada con la op por
// `id_pago` -- que es único, así una op no puede entrar dos veces.
//
// Se copia en vez de leerse al vuelo porque el seguimiento es de lo que se envió:
// si después alguien corrige el pago en gestión, la copia se sincroniza (ver
// sincronizarMovimientoCM en lib/cajaMayor.js) para que el saldo no mienta, pero
// el movimiento existe desde el momento de la carga y no depende de que alguien
// lo toque en el módulo.

// Ciclo de una op que sale de gestión hacia la caja mayor: el local la ENVIA y el
// CM confirma que la RECIBIÓ. La app vieja llamaba ENVIADA "ESTUDIO" (1271 filas
// ahí contra 364 recibidas) -- mismo estado, nombre que no decía nada.
//
// Los movimientos que nacen en el módulo (PROPIO, APERTURA) no tienen este ciclo:
// nadie los envía. Quedan en ENVIADA y el módulo no les ofrece el botón.
enum EstadoCM {
  ENVIADA
  RECIBIDA

  @@map("estado_cm")
}

enum MonedaCM {
  ARS
  USD
  EUR
  BRL

  @@map("moneda_cm")
}

// De dónde salió el movimiento. Es lo que decide qué se puede editar: los PAGO
// son espejo de una op de gestión (acá solo se gestiona su estado), el resto
// nace y se edita en este módulo.
//
// En la app vieja esto era la columna `Movimiento`, un Yes/No: true para lo que
// llegaba de gestión (1622 filas con Orden OP-) y false para lo cargado a mano
// (1603 con Orden CM-). Acá es un enum porque además hay que distinguir el saldo
// de apertura, que allá se cargaba como un movimiento normal con la observación
// "Saldo Inicial" a mano (6 filas así en el export).
enum OrigenCM {
  PAGO // op de gestión con id_tipo = 'CM'
  PROPIO // cargado a mano en el módulo
  APERTURA // saldo inicial del local, uno por local y moneda

  @@map("origen_cm")
}

model MovimientoCM {
  id       String   @id @default(uuid())
  id_local String
  origen   OrigenCM
  moneda   MonedaCM @default(ARS)

  // Solo para origen PAGO: la op de gestión de la que es copia. Único, así una op
  // no puede entrar dos veces a la caja mayor -- es lo que hace que la copia sea
  // idempotente y no haya que cruzar por fecha+importe.
  id_pago String? @unique

  // Copiados del pago cuando origen = PAGO; propios en los demás casos. Nullable
  // solo porque la columna existía antes de que la copia fuera explícita: en la
  // práctica los movimientos siempre los tienen.
  fecha   DateTime?
  importe Decimal?  @db.Decimal(12, 2) // siempre positivo, la dirección va en `ingreso`

  // Dirección respecto de la CAJA MAYOR (no del local): true = entra plata a la
  // caja mayor. Al copiar se calcula con direccionCajaMayor() en lib/cajaMayor.js;
  // si alguien la corrige a mano queda `direccion_manual` en true y desde entonces
  // la sincronización no la vuelve a tocar.
  ingreso          Boolean?
  direccion_manual Boolean  @default(false)

  estado           EstadoCM  @default(ENVIADA)
  recibe           String?
  extrae           String?
  fecha_extraccion DateTime?
  observaciones    String?

  // Quién y cuándo la marcó RECIBIDA. Es el dato que hoy no queda en ningún lado
  // cuando alguien aprieta el botón en AppSheet.
  recibida_at DateTime?
  recibida_by String?

  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  local    Local @relation(fields: [id_local], references: [id])
  pago     Pago? @relation(fields: [id_pago], references: [id])
  creador  User? @relation("MovimientoCMCreatedBy", fields: [created_by], references: [id])
  receptor User? @relation("MovimientoCMRecibidaBy", fields: [recibida_by], references: [id])

  // El listado siempre pide por local + moneda y ordena por fecha; el saldo
  // filtra por estado. Las FK van indexadas a propósito: Prisma no las indexa
  // sola y ya hubo cinco casos de lentitud por eso (ver PR #114).
  @@index([id_local, moneda, fecha])
  @@index([estado])
  @@index([created_by])
  @@index([recibida_by])
  @@map("movimientos_cm")
}

// Nota: NO hay tabla de cambio de moneda. La app vieja tenía una (`CAMBIO`, con
// importe, cotización y monedas de compra/venta) y quedó con CERO filas en dos
// años de uso, así que no se replicó. La caja en dólares sí existe y está viva
// -- 217 filas en CM_DOLAR -- pero se resuelve con la columna `moneda` de arriba,
// no con una tabla espejo como hacía AppSheet.
